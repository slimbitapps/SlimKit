{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlimVoice",
  "version": "0.3.0",
  "identifier": "app.slimbit.slimvoice",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5299",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "publisher": "SlimBit Apps",
    "copyright": "SlimBit Apps",
    "category": "Productivity",
    "shortDescription": "Dictation that works – in every app",
    "longDescription": "Free dictation for Windows & Mac: hold a shortcut, speak, and clean text appears where your cursor is. Local and private with whisper.cpp or via online services.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}